# Rust build output
/target

# Guest root filesystems live under roots/ (fetch with scripts/fetch-rootfs.sh).
# The directory's README is tracked; the downloaded trees are not.
/roots/*
!/roots/README.md

# Scratch / runtime artifacts
/tmp
/.apchat-large-outputs
*.o
*.log
*.swp

# Prebuilt guest test binaries (regenerate from tests/)
/busybox
/hello_*
/test_suite
/test_pipe_*

# macOS
.DS_Store

# ARM ISA XML — not bundled (ARM-licensed); see data/encoding/README.md
data/encoding/*.xml
data/encoding/*.dtd
